*.iso
*.img
*.wim
*.esd
*.vhd
*.vhdx

# 资源库中的安装包与生成物：保留目录结构，不提交二进制内容
/InstallKit/00_System/WindowsISO/
/InstallKit/01_Network/
/InstallKit/02_Drivers/
/InstallKit/03_Runtime/
# 04_Tools 不再整体忽略：HTML/bat 这类源码文件要进仓库，二进制由扩展名规则覆盖
/InstallKit/04_Tools/Archive/
/InstallKit/04_Tools/Browser/
/InstallKit/04_Tools/Terminal/
/InstallKit/04_Tools/Diagnostics/SysinternalsSuite.zip
# 05_Applications/CameraTools：README / 测试源码进仓库，二进制安装包由底部的 *.exe/*.msi/*.zip 规则统一忽略
/InstallKit/07_Logs/
/InstallKit/08_DownloadCache/
/InstallKit/09_Reports/

